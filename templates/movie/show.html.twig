<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ movie.name }}</title>
    <style>
        body { font-family: sans-serif; margin: 2rem; max-width: 720px; }
        .badge { background: #ffc107; padding: .2rem .6rem; border-radius: 999px; font-weight: bold; }
    </style>
</head>
<body>
    <a href="{{ path('app_movie_index') }}">← Retour au catalogue</a>

    <h1>{{ movie.name }}</h1>
    <p>{{ movie.category|upper }} · {{ movie.releaseYear }}</p>
    <p>{{ movie.synopsis }}</p>
    <p>Note : {{ movie.rating is empty ? 'Non noté' : movie.rating }}</p>

    {% if movie.rating >= 4.5 %}
        <span class="badge">⭐ Coup de cœur</span>
    {% endif %}
</body>
</html>