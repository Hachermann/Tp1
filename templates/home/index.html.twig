{% extends 'base.html.twig' %}
{% block body %}
        <h1>Catalogue</h1>
        <p class="subtitle">{{ movies|length }} film{{ movies|length > 1 ? 's' : '' }} disponible{{ movies|length > 1 ? 's' : '' }}</p>

        {% if tag is defined and tag != 'general' %}
            <p class="subtitle">Recherche : {{ tag|upper }}</p>
        {% endif %}

        <div class="grid">
            {% for movie in movies %}
                <article class="card">
                    <span class="category">{{ movie.category|upper }}</span>
                    <h2>{{ movie.name }}</h2>
                    <p>Sortie : {{ movie.releaseYear }}</p>
                    <p>{{ movie.synopsis|slice(0, 120) }}{% if movie.synopsis|length > 120 %}…{% endif %}</p>

                    {% if movie.rating >= 4.5 %}
                        <span class="badge">⭐ Coup de cœur</span>
                    {% endif %}

                    <a class="btn" href="{{ path('app_movie_show', {id: movie.id}) }}">Voir les détails</a>
                </article>
            {% else %}
                <p class="empty">Aucun film à afficher.</p>
            {% endfor %}
        </div>
        {% endblock %}


